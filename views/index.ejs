<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GQOM Lab RSVP</title>

    <link rel="stylesheet" href="/style.css" />
    <script src="/script.js"></script>
  </head>

  <body>
    <div class="container">
      <!-- LOGO -->
      <img src="/images/logo.png" alt="GQOM Lab Logo" class="logo" />

      <!-- TITLE -->
      <h1>The Lab is Open</h1>

      <!-- FORM -->
      <form action="/submit" method="POST">
        <label>First Name</label>
        <input type="text" name="firstName" required />

        <label>Last Name</label>
        <input type="text" name="lastName" required />

        <label>Email</label>
        <input type="email" name="email" required />

        <label>Phone</label>
        <input type="tel" name="phone" required />

        <label>Invite Code</label>
        <input type="text" name="inviteCode" required />

        <label>Coming?</label>
        <select name="coming" required>
          <option value="">Select...</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>

        <label>Plus One(s)</label>
        <input type="number" name="plusOnes" min="0" placeholder="0" />

        <button type="submit">Submit</button>
      </form>
    </div>
  </body>
</html>
